{
  "name": "audio-switcher-mac",
  "version": "1.0.0",
  "description": "Minimal audio output switcher for macOS",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac dmg zip"
  },
  "author": "Shuichi",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "build": {
    "files": [
      "package.json",
      "src/**",
      "node_modules/**"
    ],
    "appId": "com.shuichi.audio-switcher-mac",
    "productName": "Audio Switcher",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
